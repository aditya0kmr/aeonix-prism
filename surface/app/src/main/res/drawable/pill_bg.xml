<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF00E5FF" android:endColor="#FF00B0FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#5900E5FF" />
            <stroke android:width="1.5dp" android:color="#FF00E5FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2200E5FF" android:endColor="#0C07101E" />
            <stroke android:width="1dp" android:color="#4000E5FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
