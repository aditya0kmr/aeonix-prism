<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:id="@+id/raceBar"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />

        <!-- game_day: one dot per turn when the panel rotates between games (and the F1 weekend). -->
        <LinearLayout
            android:id="@+id/racePager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <!-- Category & Resolution Badge -->
        <TextView
            android:id="@+id/heroCategoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAMING · 1080P"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:fontFamily="@string/font_medium"
            android:background="@drawable/pill_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@string/font_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="6dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />

                        <!-- Lunar date ("Lunar 13/9 · Year of the Horse"), shown when lunar_date is on. -->
                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Interactive System & Atmospheric HUD Row -->
            <LinearLayout
                android:id="@+id/hudTickerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/pill_bg"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#E600E5FF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.05"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/grid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weatherHud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/pill_bg"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="ATMOS // SYNCHRONIZING..."
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.05"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnVpn"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:singleLine="true"
                    android:text="@string/vpn"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps_pill"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnIptv"
                    style="@style/TopButton"
                    android:text="IPTV"
                    android:drawableStart="@drawable/ic_iptv"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnArcade"
                    style="@style/TopButton"
                    android:text="ARCADE"
                    android:drawableStart="@drawable/ic_arcade"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnTerminal"
                    style="@style/TopButton"
                    android:text="CONSOLE"
                    android:drawableStart="@drawable/ic_terminal"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnTheme"
                    style="@style/TopButton"
                    android:text="THEME"
                    android:drawableStart="@drawable/ic_theme"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWallpaper"
                    style="@style/TopButton"
                    android:text="WALLPAPER"
                    android:drawableStart="@drawable/ic_picture"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Holo-Arcade Minigame Overlay -->
    <FrameLayout
        android:id="@+id/arcadeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA04060C"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.gathin.tvhome.arcade.HoloArcadeView
            android:id="@+id/holoArcade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />
    </FrameLayout>

    <!-- Cyber Terminal Console Overlay -->
    <FrameLayout
        android:id="@+id/terminalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA040710"
        android:padding="48dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/glass_panel"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AETHER // CYBER DIAGNOSTIC CONSOLE"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btnCloseTerminal"
                    style="@style/TopButton"
                    android:text="CLOSE [BACK]"
                    android:focusable="true"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="#3300E5FF" />

            <!-- Interactive Diagnostic Action Pills -->
            <LinearLayout
                android:id="@+id/terminalActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnTrimMemory"
                    style="@style/TopButton"
                    android:layout_marginStart="0dp"
                    android:text="TRIM RAM"
                    android:textColor="#00E5FF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnTestAudio"
                    style="@style/TopButton"
                    android:text="TEST AUDIO"
                    android:textColor="#00E5FF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnConsoleTheme"
                    style="@style/TopButton"
                    android:text="CYCLE THEME"
                    android:textColor="#00E5FF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnConsoleWallpaper"
                    style="@style/TopButton"
                    android:text="NEXT WALLPAPER"
                    android:textColor="#00E5FF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnUnhideApps"
                    style="@style/TopButton"
                    android:text="UNHIDE APPS"
                    android:textColor="#00E5FF"
                    android:focusable="true" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/terminalLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CC88A0B2"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- AETHER IPTV Quantum Stream Deck Overlay -->
    <FrameLayout
        android:id="@+id/iptvOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA04060C"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Split Browser View Container -->
        <LinearLayout
            android:id="@+id/iptvBrowserContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Top Header & Category Filter Bar -->
            <LinearLayout
                android:id="@+id/iptvHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/iptvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AETHER // QUANTUM STREAM DECK"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/iptvChannelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/pill_bg"
                    android:text="175 ONLINE"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@string/font_medium" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnSearchIptv"
                    style="@style/TopButton"
                    android:layout_marginEnd="10dp"
                    android:text="SEARCH [🔍]"
                    android:textColor="#00E5FF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnAddM3uUrl"
                    style="@style/TopButton"
                    android:layout_marginEnd="10dp"
                    android:text="+ M3U PLAYLIST"
                    android:textColor="#CCFFFFFF"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnCloseIptv"
                    style="@style/TopButton"
                    android:text="CLOSE [BACK]"
                    android:focusable="true"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <!-- Category Pills Horizontal Scroll -->
            <HorizontalScrollView
                android:id="@+id/iptvCategoryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/iptvCategoryTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:id="@+id/iptvDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="#2600E5FF" />

            <!-- Split Screen Body: Left Channel List + Right Video Stage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Left: Channels List -->
                <LinearLayout
                    android:id="@+id/iptvLeftPane"
                    android:layout_width="480dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginEnd="18dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/iptvChannelsRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:descendantFocusability="afterDescendants"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- Right: Video Stage & Channel HUD -->
                <FrameLayout
                    android:id="@+id/iptvStageFrame"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/glass_panel"
                    android:padding="6dp">

                    <VideoView
                        android:id="@+id/iptvVideoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- Loading / Buffering HUD -->
                    <LinearLayout
                        android:id="@+id/iptvBufferingHud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TUNING QUANTUM STREAM..."
                            android:textColor="#00E5FF"
                            android:textSize="12sp"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <!-- Stream Info HUD -->
                    <LinearLayout
                        android:id="@+id/iptvStageHud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="#D0040710"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/iptvCurrentChannelName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SELECT A CHANNEL"
                                android:textColor="#FFFFFFFF"
                                android:textSize="17sp"
                                android:fontFamily="@string/font_medium" />

                            <TextView
                                android:id="@+id/btnIptvFullscreen"
                                style="@style/TopButton"
                                android:text="FULLSCREEN [OK]"
                                android:focusable="true"
                                android:nextFocusLeft="@+id/iptvChannelsRecycler"
                                android:textColor="#00E5FF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/iptvStreamSpecs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="HLS PROTOCOL • 1080p READY • D-PAD CONTROLS"
                            android:textColor="#66FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Fullscreen HUD Banner (shows briefly in Fullscreen mode) -->
        <LinearLayout
            android:id="@+id/iptvFullscreenHud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E6040712"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/iptvFullscreenChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[▲/▼] TUNE   •   [MENU] FAVORITE ★   •   [BACK] GUIDE"
                android:textColor="#8000E5FF"
                android:textSize="12sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
