<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iptvOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA04060C"
    android:clickable="true"
    android:focusable="true">

    <!-- Split Browser View Container -->
    <LinearLayout
        android:id="@+id/iptvBrowserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Top Header & Category Filter Bar -->
        <LinearLayout
            android:id="@+id/iptvHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/iptvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AETHER // QUANTUM STREAM DECK"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/iptvChannelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/pill_bg"
                android:text="175 ONLINE"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@string/font_medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSearchIptv"
                style="@style/TopButton"
                android:layout_marginEnd="10dp"
                android:text="SEARCH [🔍]"
                android:textColor="#00E5FF"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnAddM3uUrl"
                style="@style/TopButton"
                android:layout_marginEnd="10dp"
                android:text="+ M3U PLAYLIST"
                android:textColor="#CCFFFFFF"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCloseIptv"
                style="@style/TopButton"
                android:text="CLOSE [BACK]"
                android:focusable="true"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <!-- Category Pills Horizontal Scroll -->
        <HorizontalScrollView
            android:id="@+id/iptvCategoryScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/iptvCategoryTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:id="@+id/iptvDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#2600E5FF" />

        <!-- Split Screen Body: Left Channel List + Right Video Stage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left: Channels List -->
            <LinearLayout
                android:id="@+id/iptvLeftPane"
                android:layout_width="480dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginEnd="18dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/iptvChannelsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:descendantFocusability="afterDescendants"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!-- Right: Video Stage & Channel HUD -->
            <FrameLayout
                android:id="@+id/iptvStageFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/glass_panel"
                android:padding="6dp">

                <VideoView
                    android:id="@+id/iptvVideoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <!-- Loading / Buffering HUD -->
                <LinearLayout
                    android:id="@+id/iptvBufferingHud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="TUNING QUANTUM STREAM..."
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <!-- Stream Info HUD -->
                <LinearLayout
                    android:id="@+id/iptvStageHud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#D0040710"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/iptvCurrentChannelName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SELECT A CHANNEL"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@string/font_medium" />

                        <TextView
                            android:id="@+id/btnIptvFullscreen"
                            style="@style/TopButton"
                            android:text="FULLSCREEN [OK]"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/iptvChannelsRecycler"
                            android:textColor="#00E5FF" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/iptvStreamSpecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="HLS PROTOCOL • 1080p READY • D-PAD CONTROLS"
                        android:textColor="#66FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen HUD Banner (shows briefly in Fullscreen mode) -->
    <LinearLayout
        android:id="@+id/iptvFullscreenHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6040712"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/iptvFullscreenChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[▲/▼] TUNE   •   [MENU] FAVORITE ★   •   [BACK] GUIDE"
            android:textColor="#8000E5FF"
            android:textSize="12sp"
            android:letterSpacing="0.05" />
    </LinearLayout>
</FrameLayout>
